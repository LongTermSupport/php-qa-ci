# PHP-QA-CI Optional Rules — Generic
#
# Rules suitable for any PHP project (no framework dependency).
#
# To enable in your project, add to your qaConfig/phpstan.neon:
#
#     includes:
#         - ../vendor/lts/php-qa-ci/rules-optional.neon
#
# For Symfony/Doctrine projects use rules-optional-symfony.neon instead,
# which includes this file plus Symfony-specific rules.
#
# To enable individual rules instead, copy the relevant lines into your
# project's phpstan.neon rules: section.
#
# ─────────────────────────────────────────────────────────────────────────────
# OPINIONATED (any PHP project):
#   ForbidNullCoalescingEmptyStringRule  — bans `?? ''` (almost always a bug)
#   ForbidNullCoalescingFalseRule        — bans `?? false` (use explicit null checks)
#
# STRICT EXCEPTION HANDLING:
#   ForbidSilentCatchRule                — catch blocks must use the caught exception
#                                          (stricter than the default ForbidEmptyCatchBlockRule)
#
# READONLY SERVICES (enforce immutable services):
#   RequireReadonlyServiceRule           — service classes must be "final readonly class"
#
# VARIADIC OVER AN ARRAY PARAMETER:
#   RequireVariadicOverArrayParameterRule — a method's LAST parameter declared `array` whose
#                                          element type lives only in a @param list<T> docblock
#                                          should be T ...$param, which the engine checks at
#                                          every call. Promoted, by-ref, map-typed, constructor,
#                                          #[DataProvider] and supertype-bound parameters are
#                                          excluded, because none can become a variadic. See
#                                          docs/phpstan-rules/require-variadic-over-array-parameter.md
#
# INSECURE FUNCTIONS (lists lifted from spaze/phpstan-disallowed-calls, MIT):
#   ForbidInsecureFunctionsRule          — broken hashes (md5/sha1, and hash* with a literal
#                                          md5/sha1 algorithm), predictable randomness
#                                          (rand/mt_rand/lcg_value/uniqid) and the
#                                          unparameterised MySQL query functions. Opt-in:
#                                          hashing for cache keys is not a defect. See
#                                          docs/phpstan-rules/forbid-insecure-functions.md
#
# DEBUG OUTPUT LEFT IN PLACE:
#   ForbidDebugOutputFunctionsRule       — var_dump, print_r and var_export when they PRINT.
#                                          The return-string forms print_r($x, true) and
#                                          var_export($x, true) are allowed, which is why
#                                          this is a rule and not a grep. See
#                                          docs/phpstan-rules/forbid-debug-output-functions.md
#
# THE PROCESS'S OWN STREAMS:
#   ForbidProcessStreamRule              — STDIN/STDOUT/STDERR; php://stdin, stdout, stderr
#                                          or fd/N opened by name; new ConsoleOutput();
#                                          readline(); error_log() to the SAPI logger: inside
#                                          a class, function or closure, where a test can
#                                          call it. A test can neither capture nor assert the
#                                          output, and a stderr write stops Infection's initial
#                                          test run; take the stream as a parameter. Script-level
#                                          code and PHPUnit runner extensions are exempt. See
#                                          docs/phpstan-rules/forbid-process-stream.md
#
# REPEATED STRING LITERAL:
#   ForbidRepeatedStringLiteralRule      — the same string literal (3+ chars) written 3+
#                                          times in one class is an undeclared constant;
#                                          array keys and attribute arguments not counted.
#                                          See docs/phpstan-rules/forbid-repeated-string-literal.md
#
# MEMBER DOCS ALL-OR-NONE (per kind):
#   RequireConsistentMemberDocsRule      — a class documents every constant or none, and
#                                          every property (declared or promoted) or none;
#                                          tag-only docblocks do not count; methods are not
#                                          checked. The fix is usually deleting comments
#                                          that restate the name. See
#                                          docs/phpstan-rules/require-consistent-member-docs.md
#
# ENUM OVER A DOCBLOCK LITERAL SET:
#   RequireEnumOverLiteralUnionRule      — a scalar @param/@return typed as 'a'|'b' (or 0|1)
#                                          in the docblock is an enum that never got declared;
#                                          declare a backed enum. See
#                                          docs/phpstan-rules/require-enum-over-literal-union.md
#
# FACTORY-SEALED CONSTRUCTION:
#   FactorySealedRule                    — a class marked with a sealing attribute
#                                          (#[FactorySealedBy(Factory::class)], or any
#                                          project-defined attribute whose first argument
#                                          is the factory class-string) may be constructed
#                                          only by that factory; a direct `new X(...)`
#                                          anywhere else in production code is flagged
#                                          (tests exempt). Configure which attributes count
#                                          as sealing markers via
#                                          parameters.phpqaciFactorySealed.attributeClasses
#                                          — default is the package's reference attribute.
#                                          A project that annotates PRODUCTION code should
#                                          register its OWN attribute FQCN so its classes
#                                          need not `use` this dev-only QA package.
#
# DEPRECATED PHPUNIT METHODS:
#   ForbidDeprecatedPhpunitMethodRule    — flags calls to a method deprecated by the
#                                          INSTALLED PHPUnit (e.g. expectExceptionMessage()).
#                                          The deprecated set is discovered dynamically by
#                                          reflection (no hard-coded list), so it stays
#                                          correct as PHPUnit evolves. Only calls on a PHPUnit
#                                          type (TestCase/Assert or a subclass) are flagged.
#
# VARIADIC OVER A LAST ARRAY PARAMETER:
#   RequireVariadicOverArrayParameterRule — a method/function's LAST parameter, declared
#                                          `array` and PHPDoc-annotated as a homogeneous
#                                          list (`list<T>`, `non-empty-list<T>`, or
#                                          `array<T>` with no key type), could be a native
#                                          variadic `T ...$name` instead — engine-checked at
#                                          every call site instead of docblock-only. Skips
#                                          promoted/by-ref/already-variadic parameters, map
#                                          and shape docblock types, __construct (PHPStan's
#                                          own neon DI passes one positional value per
#                                          argument), PHPUnit data-provided methods, and any
#                                          method that implements an interface or overrides a
#                                          parent (the signature is not this declaration's to
#                                          change). See
#                                          docs/phpstan-rules/require-variadic-over-array-parameter.md
#
# AMBIGUOUS ARRAY DOCBLOCK TYPE:
#   ForbidAmbiguousArrayDocRule          — a @param/@return/@var type written `T[]` or
#                                          `array<T>` (one argument) states nothing about the
#                                          keys: PHPStan resolves both to array<mixed, mixed>.
#                                          Write `list<T>` for a list or `array<K, V>` for a
#                                          map. The other half of the variadic rule, which
#                                          ignores these forms precisely because they may be
#                                          maps. See
#                                          docs/phpstan-rules/forbid-ambiguous-array-doc.md
#
# A REGEX PATTERN THE CODE DOES NOT OWN:
#   ForbidUnvalidatedRegexPatternRule    — a preg_* call (PHP's or thecodingmachine/safe's)
#                                          whose pattern is neither literal-string typed nor
#                                          built in the call from literals and preg_quote()
#                                          with its delimiter must run inside a try whose
#                                          finally restores an error handler its function
#                                          installed before the call: PCRE only warns
#                                          on a pattern that does not compile, naming neither
#                                          the pattern nor where it came from. A local
#                                          variable counts as owned when every write to it in
#                                          its function is. Its four collectors are
#                                          registered under services: below. See
#                                          docs/phpstan-rules/forbid-unvalidated-regex-pattern.md
#
# GIT IN A TEST, ISOLATED FROM THE HOST:
#   ForbidUnisolatedGitProcessRule       — test code (TestCodeDetector: a file under the
#                                          project's own tests/, or a namespace with a
#                                          segment ending in Tests)
#                                          that runs git through a Symfony Process,
#                                          Process::fromShellCommandline or proc_open must
#                                          give it an environment PHPStan can see sets
#                                          GIT_CONFIG_GLOBAL and GIT_CONFIG_NOSYSTEM: the
#                                          host's signing, hooks or default branch otherwise
#                                          decide what the test sees. See
#                                          docs/phpstan-rules/forbid-unisolated-git-process.md
#
# AN ARRAY KEY THAT MAY BE ALL DIGITS:
#   ForbidNumericStringArrayKeyRule      — PHP stores an array key that is an all-digit
#                                          string ('2024') as an int, but PHPStan types
#                                          $map[$string] = … as string-keyed. A write under
#                                          a key that may be all digits is reported when its
#                                          array is a property declared string-keyed, or a
#                                          local the same function returns, passes or
#                                          assigns as string-keyed, or whose keys it reads.
#                                          Keys made by a literal, array_flip() and the
#                                          like, or asserted by an inline @var over decoded
#                                          data, are judged the same way.
#                                          Declare such keys array-key and cast a key to
#                                          string where one is read. Its collector is
#                                          registered under services: below. See
#                                          docs/phpstan-rules/forbid-numeric-string-array-key.md
#
# ─────────────────────────────────────────────────────────────────────────────
# EXPERIMENTAL — NOT auto-loaded (high false-positive rate; opt-in only):
#   ForbidMagicStringAssertionRule       — flags test assertions that pin an
#                                          identifier-like string against a plain
#                                          `string`, on the theory the value should
#                                          be a backed enum. Empirically too noisy
#                                          for a default: it cannot distinguish a
#                                          should-be-enum value from a wire-contract
#                                          key (cf_*), fixture data, an id, or a
#                                          param/type name — all of which are
#                                          identifier-like single tokens. Enable
#                                          deliberately for a one-off magic-string
#                                          cleanup sweep and eyeball the results;
#                                          do not run it in CI. Cherry-pick it:
#                                          - LTS\PHPQA\PHPStan\Rules\ForbidMagicStringAssertionRule
# ─────────────────────────────────────────────────────────────────────────────

rules:
    - LTS\PHPQA\PHPStan\Rules\ForbidNullCoalescingEmptyStringRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNullCoalescingFalseRule
    - LTS\PHPQA\PHPStan\Rules\ForbidSilentCatchRule
    - LTS\PHPQA\PHPStan\Rules\RequireReadonlyServiceRule
    - LTS\PHPQA\PHPStan\Rules\RequireEnumOverLiteralUnionRule
    - LTS\PHPQA\PHPStan\Rules\ForbidRepeatedStringLiteralRule
    - LTS\PHPQA\PHPStan\Rules\RequireConsistentMemberDocsRule
    - LTS\PHPQA\PHPStan\Rules\RequireVariadicOverArrayParameterRule
    - LTS\PHPQA\PHPStan\Rules\ForbidAmbiguousArrayDocRule
    - LTS\PHPQA\PHPStan\Rules\ForbidInsecureFunctionsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidDebugOutputFunctionsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidProcessStreamRule
    - LTS\PHPQA\PHPStan\Rules\ForbidUnvalidatedRegexPatternRule
    - LTS\PHPQA\PHPStan\Rules\ForbidUnisolatedGitProcessRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNumericStringArrayKeyRule

parameters:
    phpqaciFactorySealed:
        attributeClasses:
            - LTS\PHPQA\PHPStan\Attribute\FactorySealedBy

parametersSchema:
    phpqaciFactorySealed: structure([
        attributeClasses: listOf(string())
    ])

services:
    -
        class: LTS\PHPQA\PHPStan\Rules\FactorySealedRule
        arguments:
            sealingAttributes: %phpqaciFactorySealed.attributeClasses%
        tags:
            - phpstan.rules.rule
    -
        class: LTS\PHPQA\PHPStan\Rules\ForbidDeprecatedPhpunitMethodRule
        tags:
            - phpstan.rules.rule
    # The collectors ForbidUnvalidatedRegexPatternRule (under rules: above) matches.
    -
        class: LTS\PHPQA\PHPStan\Rules\UnownedRegexPatternCollector
        tags:
            - phpstan.collector
    -
        class: LTS\PHPQA\PHPStan\Rules\RegexPatternVariableWriteCollector
        tags:
            - phpstan.collector
    -
        class: LTS\PHPQA\PHPStan\Rules\ErrorHandlerRestoringFinallyCollector
        tags:
            - phpstan.collector
    -
        class: LTS\PHPQA\PHPStan\Rules\ErrorHandlerInstallCollector
        tags:
            - phpstan.collector
    # The collector ForbidNumericStringArrayKeyRule (under rules: above) matches.
    -
        class: LTS\PHPQA\PHPStan\Rules\NumericStringArrayKeyCollector
        tags:
            - phpstan.collector
    -
        class: LTS\PHPQA\PHPStan\Rules\NumericStringArrayKeyWritesCollector
        tags:
            - phpstan.collector

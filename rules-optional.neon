# PHP-QA-CI Optional Rules — Generic
#
# Rules suitable for any PHP project (no framework dependency).
#
# To enable in your project, add to your qaConfig/phpstan.neon:
#
#     includes:
#         - ../vendor/lts/php-qa-ci/rules-optional.neon
#
# For Symfony/Doctrine projects use rules-optional-symfony.neon instead,
# which includes this file plus Symfony-specific rules.
#
# To enable individual rules instead, copy the relevant lines into your
# project's phpstan.neon rules: section.
#
# ─────────────────────────────────────────────────────────────────────────────
# OPINIONATED (any PHP project):
#   ForbidNullCoalescingEmptyStringRule  — bans `?? ''` (almost always a bug)
#   ForbidNullCoalescingFalseRule        — bans `?? false` (use explicit null checks)
#
# STRICT EXCEPTION HANDLING:
#   ForbidSilentCatchRule                — catch blocks must use the caught exception
#                                          (stricter than the default ForbidEmptyCatchBlockRule)
#
# INLINE PHPSTAN SUPPRESSION BAN:
#   ForbidInlinePhpstanIgnoreRule        — bans @phpstan-ignore annotations inline;
#                                          irreducible suppressions go in phpstan.neon ignoreErrors
#
# READONLY SERVICES (enforce immutable services):
#   RequireReadonlyServiceRule           — service classes must be "final readonly class"
#
# VARIADIC FOR SINGLE LIST PARAM:
#   RequireVariadicForSingleListParamRule — single array param annotated @param list<T>
#                                           should be variadic T ...$param instead
#
# ─────────────────────────────────────────────────────────────────────────────
# EXPERIMENTAL — NOT auto-loaded (high false-positive rate; opt-in only):
#   ForbidMagicStringAssertionRule       — flags test assertions that pin an
#                                          identifier-like string against a plain
#                                          `string`, on the theory the value should
#                                          be a backed enum. Empirically too noisy
#                                          for a default: it cannot distinguish a
#                                          should-be-enum value from a wire-contract
#                                          key (cf_*), fixture data, an id, or a
#                                          param/type name — all of which are
#                                          identifier-like single tokens. Enable
#                                          deliberately for a one-off magic-string
#                                          cleanup sweep and eyeball the results;
#                                          do not run it in CI. Cherry-pick it:
#                                          - LTS\PHPQA\PHPStan\Rules\ForbidMagicStringAssertionRule
# ─────────────────────────────────────────────────────────────────────────────

rules:
    - LTS\PHPQA\PHPStan\Rules\ForbidNullCoalescingEmptyStringRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNullCoalescingFalseRule
    - LTS\PHPQA\PHPStan\Rules\ForbidSilentCatchRule
    - LTS\PHPQA\PHPStan\Rules\ForbidInlinePhpstanIgnoreRule
    - LTS\PHPQA\PHPStan\Rules\RequireReadonlyServiceRule
    - LTS\PHPQA\PHPStan\Rules\RequireVariadicForSingleListParamRule

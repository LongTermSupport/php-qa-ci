# php-qa-ci analysing itself. The bundled rule sets reach consumers through the
# PHPStan extension installer, which never reads the root package, so they must
# be included here by hand or the self-check runs none of the rules this package
# ships. tests/Small/SelfCheckRunsBundledRulesTest.php guards this list.
includes:
    - ../rules-default.neon
    - ../rules-optional.neon

parameters:
    # tests/assets is not listed: it is in qa.php's withIgnoredPaths(), which the
    # phpstan lane writes into its wrapper neon as an excludePaths entry.
    excludePaths:
        # The plugin tests construct the plugins, and analysing a test that
        # instantiates a class implementing an interface absent at runtime is an
        # internal error in PHPStan's reflection. Runtime behaviour is covered by
        # the tests themselves; the plugins under src/ ARE analysed, via scanFiles.
        - ./../tests/Small/ComposerPlugin/*
    # composer/composer is not a dependency (only composer-plugin-api is, and it
    # ships no classes), so the Composer\* surface the plugins under
    # src/ComposerPlugin/ compile against comes from the runtime-only stubs the
    # plugin tests also load. Scanning them keeps the plugin tree analysed.
    scanFiles:
        - ../tests/assets/ComposerPlugin/composer-stubs.php
    level: max
    inferPrivatePropertyTypeFromConstructor: true

# Dead-code detection over php-qa-ci itself (Plan 00005, Phase 3 — under
# evaluation). Run by the `-t dcd` lane registered in qaConfig/pipeline.php,
# never by a phase. The detector is deliberately absent from the extension
# installer (composer.json "extra"), so this file is the only place it loads.
#
# Entry points: every @api class is one (the detector honours class-level
# @api). The PHP bin/ scripts are the other entry points and have no .php
# extension, so a directory scan would miss them; they are listed as files.
# bin/phpstan-rule is Bash and reaches SingleRuleReport::main through `php -r`,
# which no static scan can follow: that one report is a known false positive.
includes:
    - phpstan.neon
    - ../vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    paths:
        - ../src
        - ../tests
        - ../bin/bootstrap.php
        - ../bin/config-template-ignorelist-check
        - ../bin/infection-config-source-dirs-check
        - ../bin/managed-source
        - ../bin/mdlinks
        - ../bin/package-type-check
        - ../bin/phpstan-ignore-justification
        - ../bin/psr4-validate
        - ../bin/qa
        - ../bin/rule-doc
        - ../bin/rules
        - ../bin/sensitive-parameter-usage
        - ../bin/version-pins-check
    shipmonkDeadCode:
        usageExcluders:
            # A member reached only from tests is dead in production: report it.
            tests:
                enabled: true

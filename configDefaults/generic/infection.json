{
  "timeout": 10,
  "source": {
    "directories": [
      "../../../../../src"
    ]
  },
  "mutators": {
    "@default": true,
    "global-ignoreSourceCodeByRegex": [
      "#\\[\\s*[A-Za-z].*"
    ]
  },
  "logs": {
    "text": "../../../../../var/qa/infection/log.txt",
    "summary": "../../../../../var/qa/infection/summary-log.txt",
    "debug": "../../../../../var/qa/infection/debug-log.txt"
  },
  "phpUnit": {
    "configDir": "./"
  },
  "tmpDir": "../../../../../var/qa/infection/tmp"
}

parameters:
    level: max
    inferPrivatePropertyTypeFromConstructor: true
    # PHPUnit 13 + final classes: CS Fixer enforces `final` on all classes,
    # and dg/bypass-finals strips it at runtime for test doubles. But PHPStan
    # still sees the classes as final, so mock intersection types (Stub&FinalClass)
    # are unresolvable. These ignores cover the downstream type errors in tests.
    ignoreErrors:
        -
            identifier: method.unresolvableReturnType
            paths:
                - ./../tests/*
        -
            identifier: method.nonObject
            paths:
                - ./../tests/*
        -
            identifier: varTag.nativeType
            paths:
                - ./../tests/*
        -
            identifier: method.notFound
            paths:
                - ./../tests/*

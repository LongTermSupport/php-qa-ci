{
  "name": "lts/php-qa-ci",
  "description": "Simple PHP QA pipeline and scripts. Largely just a collection of dependencies with configuration and scripts to run them together",
  "license": "MIT",
  "type": "composer-plugin",
  "require": {
    "php": "^8.5",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "composer-plugin-api": "^2.0",
    "nette/neon": "^3.4.8",
    "nikic/php-parser": "^5.8",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0.18",
    "phpstan/phpstan-strict-rules": "^2.0.12",
    "phpunit/phpunit": "^13.3",
    "symfony/console": "^8.1",
    "symfony/process": "^8.1",
    "symfony/service-contracts": "^3",
    "thecodingmachine/safe": "^3.4",
    "tomasvotruba/type-coverage": "^2.3"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master"
  },
  "replace": {
    "phpstan/phpstan": "*"
  },
  "suggest": {
    "larastan/larastan": "Laravel specific checks (PHPStan wrapper)",
    "phpstan/phpstan-doctrine": "Adds checks for Doctrine",
    "phpstan/phpstan-mockery": "Prevents Mockery from failing on Stan",
    "phpstan/phpstan-symfony": "Symfony specific checks"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "LTS\\PHPQA\\": [
        "src/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LTS\\PHPQA\\Tests\\": [
        "tests/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\ActiveRulesLister\\": [
        "tests/assets/ActiveRulesLister/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\DeploySkills\\": [
        "tests/assets/deploySkills/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\AmbiguousArrayDoc\\": [
        "tests/assets/PHPStan/AmbiguousArrayDoc/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\ApiInternalLeak\\": [
        "tests/assets/PHPStan/ApiInternalLeak/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\ApiOrInternal\\": [
        "tests/assets/PHPStan/ApiOrInternal/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\BinDirTool\\": [
        "tests/assets/PHPStan/BinDirTool/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\ComposerPluginOutside\\": [
        "tests/assets/PHPStan/ComposerPluginOutside/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\ComposerPlugin\\": [
        "tests/assets/PHPStan/ComposerPlugin/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\ConsistentMemberDocs\\": [
        "tests/assets/PHPStan/ConsistentMemberDocs/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\DeprecatedPhpunit\\": [
        "tests/assets/PHPStan/DeprecatedPhpunit/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\FactorySealed\\": [
        "tests/assets/PHPStan/FactorySealed/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\RepeatedStringLiteral\\": [
        "tests/assets/PHPStan/RepeatedStringLiteral/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\SensitiveParameter\\": [
        "tests/assets/PHPStan/SensitiveParameter/"
      ],
      "LTS\\PHPQA\\Tests\\Assets\\PHPStan\\VariadicOverArrayParameter\\": [
        "tests/assets/PHPStan/VariadicOverArrayParameter/"
      ]
    }
  },
  "bin": [
    "bin/composer-require-checker",
    "bin/config-template-ignorelist-check",
    "bin/infection",
    "bin/infection-config-source-dirs-check",
    "bin/managed-source",
    "bin/mdlinks",
    "bin/opcache-optimizer-dump",
    "bin/package-type-check",
    "bin/php-cs-fixer",
    "bin/phpstan",
    "bin/phpstan-ignore-justification",
    "bin/phpstan-rule",
    "bin/psr4-validate",
    "bin/qa",
    "bin/rule-doc",
    "bin/rules",
    "bin/sensitive-parameter-usage",
    "bin/single-rule-report",
    "bin/version-pins-check"
  ],
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "bin-dir": "bin",
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    }
  },
  "extra": {
    "class": [
      "LTS\\PHPQA\\ComposerPlugin\\SkillsDeployPlugin",
      "LTS\\PHPQA\\ComposerPlugin\\PhpStanGuardPlugin",
      "LTS\\PHPQA\\ComposerPlugin\\ManagedSourceDeployPlugin"
    ],
    "defence-before-fix": {
      "known-gaps": [
        "toolchain 4.1: the PHPArkitect lane runs only over the whole class set and has no resolver for its bundled tier, so that detector as wrapped fails detector 5.2 and 6.1 to 6.3",
        "toolchain 4.1: PHPStan's native identifiers resolve online only and bin/rule-doc does not resolve them, so that detector as wrapped fails detector 6.2 and 6.3",
        "toolchain 4.2: fifteen bundled PHPStan rules resolve to a one-line index row and no page stating the correct construction",
        "toolchain 4.3: a phparkitect-baseline.json is read silently by the PHPArkitect lane, and a PHPStan baseline included from qaConfig/phpstan.neon is not checked by the justification lane",
        "toolchain 6.2: the justification lane reads qaConfig/phpstan.neon alone and not the files it includes",
        "toolchain 8.1: the release guard requires an index row, not a remediation page"
      ],
      "method": "1.0.1",
      "project": {
        "known-gaps": [
          "toolchain 4.1: the same PHPArkitect and PHPStan native-identifier gaps as the artefact, since the project runs the toolchain it ships",
          "toolchain 4.2: the same fifteen bundled rules run on this repository and resolve to no remediation page",
          "toolchain 4.3: the same silent PHPArkitect baseline route is open on this repository"
        ],
        "method": "1.0.1",
        "toolchain": "0.2.0"
      },
      "toolchain": "0.2.0"
    },
    "phpstan": {
      "includes": [
        "rules-default.neon"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "./scripts/tool-install.bash"
    ],
    "post-update-cmd": [
      "./scripts/tool-install.bash update"
    ]
  }
}

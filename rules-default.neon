rules:
    - LTS\PHPQA\PHPStan\Rules\ForbidDangerousFunctionsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidEmptyCatchBlockRule
    - LTS\PHPQA\PHPStan\Rules\RequireDeclareStrictTypesRule
    - LTS\PHPQA\PHPStan\Rules\ForbidAllowMockWithoutExpectationsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNewDateTimeRule
    - LTS\PHPQA\PHPStan\Rules\ForbidEmptyLanguageConstructRule
    - LTS\PHPQA\PHPStan\Rules\ForbidLooseComparisonRule
    - LTS\PHPQA\PHPStan\Rules\ForbidDeprecatedSerializableRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNestedTernaryRule
    # NOTE: Interface/Enum/Trait *naming* suffixes are deliberately NOT a PHPStan
    # rule. They are a structural naming convention, owned by PHPArkitect's
    # on-by-default tier (configDefaults/generic/phparkitect-rules-default.php) —
    # the single source of truth for type-suffix naming. The former
    # RequireTypeSuffixRule was migrated there; do not re-add it here.
    - LTS\PHPQA\PHPStan\Rules\RequireRuleIdentifierConstantRule
    # A rule over path-attribution logic: forbids deciding "is this file mine or a
    # dependency's" with a bare, unanchored 'vendor/' substring check anywhere in
    # this project's own source. See its class docblock for the defect this
    # guards against (ForbidMockingFinalClassRule going dark when php-qa-ci is
    # itself analysed from inside a consumer's vendor/lts/php-qa-ci/ checkout).
    - LTS\PHPQA\PHPStan\Rules\ForbidUnanchoredVendorSubstringCheckRule

# ─────────────────────────────────────────────────────────────────────────────
# RequireSensitiveParameterAttributeRule — keep passwords/secrets out of traces.
#
# PHP 8.2+ ships #[\SensitiveParameter]. When set on a parameter, PHP replaces
# the real argument with a SensitiveParameterValue placeholder in
# Throwable::getTrace(), so credentials never leak into logs / error reporters.
#
# This rule flags any parameter whose NAME looks like a credential AND whose
# type is a plausible plaintext value (string / ?string / untyped / mixed) when
# it is missing the attribute. Object-typed params and already-hashed/encoded
# names are ignored. Configure the name patterns and ignore-substrings via the
# parameters block below.
#
# NOTE: the codebase-wide "at least one #[\SensitiveParameter] exists" coverage
# check is NOT a PHPStan rule. PHPStan rules are opt-in (consumers must include
# this neon), so that check cannot be relied on estate-wide. It ships instead as
# an always-on php-qa-ci pipeline tool (`sensitiveParameterUsage`) that runs for
# every consumer via `bin/qa`. See README "SensitiveParameter usage check".
# ─────────────────────────────────────────────────────────────────────────────
parameters:
    phpqaciSensitiveParameter:
        namePatterns:
            - password
            - passwd
            - pwd
            - passphrase
            - secret
            - apiSecret
            - privateKey
            - credential
            - credentials
        ignoreSubstrings:
            - hash
            - hashed
            - encoded
            - encrypted
            - url
            - uri
            - path
    # RequireApiOrInternalTagRule — fully-qualified namespace PREFIXES whose
    # class-likes are exempt from @api/@internal classification. Generated and
    # managed trees cannot carry hand-authored tags, so list them here, e.g.:
    #   phpqaciApiOrInternal:
    #       ignoredNamespacePrefixes:
    #           - App\Generated
    #           - App\PhpQaCi
    phpqaciApiOrInternal:
        ignoredNamespacePrefixes: []
        # API-surface enforcement mode for the two rules below (RequireApiOrInternalTagRule
        # + ApiMustNotExposeInternalRule):
        #   auto   (default) — enforce iff the composer `type` is `library`
        #   always           — enforce regardless of `type` (a package that IS a consumable
        #                       library but carries a non-library type, e.g. a self-deploying
        #                       composer-plugin that still ships a public API)
        #   never            — never enforce, regardless of `type`
        enforce: auto

parametersSchema:
    phpqaciSensitiveParameter: structure([
        namePatterns: listOf(string())
        ignoreSubstrings: listOf(string())
    ])
    phpqaciApiOrInternal: structure([
        ignoredNamespacePrefixes: listOf(string())
        enforce: string()
    ])

services:
    -
        class: LTS\PHPQA\PHPStan\Rules\VendoredCodeDetector
        arguments:
            currentWorkingDirectory: %currentWorkingDirectory%
    -
        class: LTS\PHPQA\PHPStan\Rules\ForbidMockingFinalClassRule
        tags:
            - phpstan.rules.rule
    # ForbidHttpPrefixedEnvVarsRule — the violation lives in Symfony YAML
    # config and .env files, not PHP AST, so the rule reaches those itself
    # (plain file reads — see its own docblock for why this is not a
    # shelled-out grep). Auto-skips cleanly on any consumer with neither
    # symfony/dependency-injection nor symfony/dotenv installed — no manual
    # opt-out flag, so it can never be silently forgotten on a project that
    # DOES use Symfony. See docs/phpstan-rules/forbid-http-prefixed-env-vars.md.
    -
        class: LTS\PHPQA\PHPStan\Rules\ForbidHttpPrefixedEnvVarsRule
        arguments:
            projectRoot: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: LTS\PHPQA\PHPStan\Rules\RequireSensitiveParameterAttributeRule
        arguments:
            namePatterns: %phpqaciSensitiveParameter.namePatterns%
            ignoreSubstrings: %phpqaciSensitiveParameter.ignoreSubstrings%
        tags:
            - phpstan.rules.rule
    # Package-type-aware API-surface classification (default-on). For a
    # `type: library` project (Composer's silent default when type is omitted),
    # every public class-like must be classified as exactly one of @api / @internal;
    # for any other type the rule no-ops. The collaborators are autowired from the
    # services below; ignored namespace prefixes come from the parameter above.
    -
        class: LTS\PHPQA\PackageType\ProjectComposerTypeReader
        arguments:
            enforceMode: %phpqaciApiOrInternal.enforce%
    - LTS\PHPQA\PackageType\DevAutoloadNamespaceReader
    - LTS\PHPQA\PHPStan\Rules\ApiOrInternalTagDetector
    -
        class: LTS\PHPQA\PHPStan\Rules\RequireApiOrInternalTagRule
        arguments:
            ignoredNamespacePrefixes: %phpqaciApiOrInternal.ignoredNamespacePrefixes%
        tags:
            - phpstan.rules.rule
    # API-surface integrity (default-on, library-only): an @api class-like must not
    # expose an @internal one (same package) through its public signature — else the
    # @api promise is hollow and a consumer is forced to touch an @internal type.
    # Complements RequireApiOrInternalTagRule (presence) with coherence. The
    # ReflectionProvider is autowired by PHPStan core.
    -
        class: LTS\PHPQA\PHPStan\Rules\ApiMustNotExposeInternalRule
        tags:
            - phpstan.rules.rule

rules:
    - LTS\PHPQA\PHPStan\Rules\ForbidDangerousFunctionsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidEmptyCatchBlockRule
    - LTS\PHPQA\PHPStan\Rules\RequireDeclareStrictTypesRule
    - LTS\PHPQA\PHPStan\Rules\ForbidAllowMockWithoutExpectationsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNewDateTimeRule
    - LTS\PHPQA\PHPStan\Rules\ForbidEmptyLanguageConstructRule
    - LTS\PHPQA\PHPStan\Rules\ForbidLooseComparisonRule
    - LTS\PHPQA\PHPStan\Rules\ForbidDeprecatedSerializableRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNestedTernaryRule
    - LTS\PHPQA\PHPStan\Rules\RequireTypeSuffixRule
    - LTS\PHPQA\PHPStan\Rules\RequireRuleIdentifierConstantRule

# ─────────────────────────────────────────────────────────────────────────────
# SensitiveParameter rules — keep passwords/secrets out of stack traces.
#
# PHP 8.2+ ships #[\SensitiveParameter]. When set on a parameter, PHP replaces
# the real argument with a SensitiveParameterValue placeholder in
# Throwable::getTrace(), so credentials never leak into logs / error reporters.
#
# Two rules are wired below:
#
#   1. requireSensitiveParameterAttribute — flags any parameter whose NAME looks
#      like a credential AND whose type is a plausible plaintext value
#      (string / ?string / untyped / mixed) when it is missing the attribute.
#      Object-typed params and already-hashed/encoded names are ignored.
#      Configure the name patterns and ignore-substrings via the parameters block.
#
#   2. requireSensitiveParameterUsage (+ collector) — a codebase-wide backstop
#      that fails once if #[\SensitiveParameter] appears NOWHERE in the analysed
#      code. This catches credentials carried under non-obvious names that the
#      name heuristic of rule 1 cannot see (e.g. $token, $dsn, $apiKey).
#
#      ESCAPE HATCH: a small number of projects genuinely never handle a
#      password / token / secret. For those, set
#      `phpqaciSensitiveParameter.requireAtLeastOneUsage: false` in your
#      qaConfig/phpstan.neon and rule 2 becomes a no-op. MOST projects should
#      instead add #[\SensitiveParameter] to the relevant parameter somewhere.
#
#      NOTE: enabling rule 2 by default means every project's CI now requires
#      EITHER at least one #[\SensitiveParameter] annotation OR the opt-out flag.
# ─────────────────────────────────────────────────────────────────────────────
parameters:
    phpqaciSensitiveParameter:
        namePatterns:
            - password
            - passwd
            - pwd
            - passphrase
            - secret
            - apiSecret
            - privateKey
            - credential
            - credentials
        ignoreSubstrings:
            - hash
            - hashed
            - encoded
            - encrypted
        requireAtLeastOneUsage: true

parametersSchema:
    phpqaciSensitiveParameter: structure([
        namePatterns: listOf(string())
        ignoreSubstrings: listOf(string())
        requireAtLeastOneUsage: bool()
    ])

services:
    -
        class: LTS\PHPQA\PHPStan\Rules\ForbidMockingFinalClassRule
        tags:
            - phpstan.rules.rule
    -
        class: LTS\PHPQA\PHPStan\Rules\RequireSensitiveParameterAttributeRule
        arguments:
            namePatterns: %phpqaciSensitiveParameter.namePatterns%
            ignoreSubstrings: %phpqaciSensitiveParameter.ignoreSubstrings%
        tags:
            - phpstan.rules.rule
    -
        class: LTS\PHPQA\PHPStan\Rules\RequireSensitiveParameterUsageRule
        arguments:
            requireAtLeastOneUsage: %phpqaciSensitiveParameter.requireAtLeastOneUsage%
        tags:
            - phpstan.rules.rule
    -
        class: LTS\PHPQA\PHPStan\Rules\SensitiveParameterAttributeCollector
        tags:
            - phpstan.collector

#!/usr/bin/env php
<?php declare(strict_types=1);

/*
 * Compiles each file argument through OPcache's optimizer without executing
 * it, so the dump requested with opcache.opt_debug_level lands on stderr for
 * the optimizerConstComparison lane to read. Exit 2 when OPcache is not
 * loaded, and 3 without $argv, which only the php CLI always defines; a file
 * that fails to compile is named on stderr and exit is 1.
 */

if (!\function_exists('opcache_compile_file')) {
    fwrite(STDERR, "OPcache is not loaded\n");
    exit(2);
}

if (!isset($argv)) {
    fwrite(STDERR, "No \$argv to read the files from: run this with the php CLI\n");
    exit(3);
}

$exit = 0;
foreach (\array_slice($argv, 1) as $file) {
    if (!opcache_compile_file($file)) {
        fwrite(STDERR, 'FAILED TO COMPILE: ' . $file . "\n");
        $exit = 1;
    }
}

exit($exit);

#!/usr/bin/env php
<?php declare(strict_types=1);

require __DIR__.'/bootstrap.php';

if (!isset($argv[1], $argv[2]) || '' === $argv[1] || '' === $argv[2]) {
    fwrite(\STDERR, "Usage: composer-require-checker-safe-scan-files-check <path-to-composerRequireChecker.json> <project-root>\n");
    exit(1);
}

die(\LTS\PHPQA\ComposerRequireChecker\SafeScanFilesCheck::main($argv[1], $argv[2]));

#!/usr/bin/env php
<?php declare(strict_types=1);

require __DIR__.'/bootstrap.php';

if (!isset($argv[1]) || '' === $argv[1]) {
    fwrite(\STDERR, "Usage: phpunit-config-version-check <path-to-phpunit.xml>\n");
    exit(1);
}

die(\LTS\PHPQA\PhpUnitConfig\PhpUnitConfigVersionCheck::main($argv[1]));

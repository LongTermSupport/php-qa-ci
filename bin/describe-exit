#!/usr/bin/env php
<?php declare(strict_types=1);

/*
 * Prints how a child process ended, from its exit code: "exit code 1", or for
 * a signal kill "exit code 143, killed by signal 15 (SIGTERM)". A script puts
 * this in the line that reports a child's failure, because a child killed by
 * a signal prints nothing about it. php-qa-ci's own Bash scripts pass
 * --php-qa-ci-helper for php-qa-ci's own helpers (see ChildExit).
 *
 *   bin/describe-exit [--php-qa-ci-helper] <exit code>
 */

require __DIR__.'/bootstrap.php';

$description = \LTS\PHPQA\ComposerPlugin\ChildExit::describeArguments(...array_slice($argv ?? [], 1));
if (null === $description) {
    fwrite(STDERR, "Usage: bin/describe-exit [--php-qa-ci-helper] <exit code 0-255>\n");
    exit(2);
}

echo $description, "\n";

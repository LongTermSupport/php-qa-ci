#!/usr/bin/env bash
###################################################################
#
# PHP QA Pipeline
#
# Usage:
#
# Standard:
# ./bin/qa
#
# Run all PHPUnit tests:
# phpUnitQuickTests=0 ./bin/qa

# Early --json detection: redirect all decoration to stderr before any echo
# Full --json validation happens later in options.inc.bash
_qa_has_json_flag=0
for _qa_arg in "$@"; do
    [[ "$_qa_arg" == "--json" ]] && _qa_has_json_flag=1 && break
done
if [[ "$_qa_has_json_flag" == "1" ]]; then
    exec 3>&1 1>&2
else
    exec 3>&1
fi
unset _qa_has_json_flag _qa_arg

if [[ "$COMPOSER_RUNTIME_BIN_DIR" != "" ]]; then
  echo "new composer detected, no longer a symlink, instead its a parent script"
  binDir="$COMPOSER_RUNTIME_BIN_DIR"
  bashSource="$binDir/qa"
  qaDir="$(cd $binDir/$(grep -Po "[^']+php-qa-ci[^']+" $binDir/qa) && pwd)"
  # project root directory
  projectRoot="$COMPOSER_RUNTIME_BIN_DIR"
  while [[ ! -f $projectRoot/composer.json ]]; do
    projectRoot="$(realpath $projectRoot/../)"
  done
else
  echo "no COMPOSER_RUNTIME_BIN_DIR detected - ASSUMING THIS IS BECAUSE WE ARE RUNNING A SELF TEST ON THE QA LIBRARY"
  bashSource="${BASH_SOURCE[0]}"
  binDir="$(dirname $bashSource)"
  while [ -h "$bashSource" ]; do # resolve $bashSource until the file is no longer a symlink
    qaDir="$(cd -P "$(dirname "$bashSource")" && pwd)"
    bashSource="$(readlink "$bashSource")"
    [[ $bashSource != /* ]] && bashSource="$qaDir/$bashSource" # if $bashSource was a relative symlink, we need to resolve it relative to the path where the symlink file was located
  done
  qaDir="$(cd -P "$(dirname "$bashSource")" && pwd)"
  projectRoot="$(realpath $qaDir/../)"
fi
cd $qaDir
set -e
set -u
set -o pipefail
standardIFS="$IFS"
IFS=$'\n\t'
echo "
===========================================
$(hostname) $0 $*
===========================================
"

#### OPTIONS ###################################################

source ./../includes/options.inc.bash

# Note: fd 3 redirection is set up at the top of this script (early --json detection)
# so that ALL decoration output goes to stderr before any echo statements.

#### FUNCTIONS #################################################

phpBinPath=${PHP_QA_CI_PHP_EXECUTABLE:-$(which php)}
source ./../includes/functions.inc.bash

#### CONFIG ##################################################

# Auto-detect CI environment based on multiple factors
# 1. If CI variable already set, use that
# 2. If CLAUDECODE=1, set CI mode 
# 3. If no TTY available (stdin/stdout), set CI mode
# 4. Otherwise, default to false (interactive)

if [[ "${CI:-}" == "true" ]]; then
    # CI already explicitly set to true, keep it
    CI='true'
elif [[ "${CLAUDECODE:-}" == "1" ]]; then
    # Claude Code environment detected
    CI='true'
    echo "Claude Code environment detected - enabling CI mode"
elif [[ ! -t 0 || ! -t 1 ]]; then
    # No TTY available (non-interactive environment)
    CI='true'
    echo "Non-interactive environment detected - enabling CI mode"
else
    # Interactive environment with TTY
    CI='false'
fi

# Read-only / check mode is ORTHOGONAL to CI (interactivity). CI decides whether
# we prompt; qaReadOnly decides whether the mutating tools (Rector, PHP CS Fixer)
# may write. Auto-enabled on GitHub Actions; overridable via QA_READONLY. See
# detectReadOnly() in includes/functions.inc.bash for the full precedence rules.
qaReadOnly="$(detectReadOnly)"
export qaReadOnly
if [[ "true" == "$qaReadOnly" ]]; then
    echo "QA read-only (check) mode: fixers will NOT modify files; a pending change FAILS the run."
    echo "  (override with QA_READONLY=0 to apply fixes)"
else
    echo "QA writable mode: fixers (Rector, PHP CS Fixer) may modify files."
    echo "  (override with QA_READONLY=1 for a read-only check run, as GitHub Actions does)"
fi

# Aggregate (non-fail-fast) mode collects EVERY failing tool in one pass instead
# of stopping at the first. It only makes sense for a read-only verification run
# (fail-fast is right when applying fixes locally), so it defaults on with
# qaReadOnly and can be forced off with QA_FAIL_FAST=1.
if [[ "true" == "$qaReadOnly" && "${QA_FAIL_FAST:-}" != "1" ]]; then
    qaAggregate='true'
    echo "QA aggregate mode: all tools run; failures are collected and reported together (not fail-fast)."
    echo "  (override with QA_FAIL_FAST=1 to stop at the first failing tool)"
else
    qaAggregate='false'
fi
export qaAggregate
qaFailedTools=()

# the path in the project to check for config
projectConfigPath="$projectRoot/qaConfig/"

# Which platform is the code to be tested
platform="$(detectPlatform)"
echo "$platform platform detected"

echo "

Checking for Xdebug
-------------------
"
if [[ "" == "$($phpBinPath -i | grep xdebug)" ]]; then
  xdebugEnabled=0
  echo "Xdebug is not enabled - infection and coverage not available"
else
  xdebugEnabled=1
  # @see https://xdebug.org/docs/all_settings#mode
  if [[ ${XDEBUG_MODE:-} != "debug" ]]; then
    XDEBUG_MODE=coverage
  fi
  export XDEBUG_MODE
  echo "Xdebug is enabled in $XDEBUG_MODE mode"
fi

echo "

Setting Project Paths
---------------------
"
runTool setPaths

echo "

Setting phpqa Config
--------------------
"
runTool setConfig

if [[ "$specifiedPath" != "" ]]; then
  echo "Only scanning the specified path $specifiedPath"
  pathsToCheck=()
  pathsToCheck+=($projectRoot/$specifiedPath)
fi

#### PRE PROCESS #############################################

hasBeenRestarted="false"

# override configs with project configs
overridePath="$projectConfigPath/qaConfig.inc.bash"

if [[ -f "$overridePath" ]]; then
  echo "

Found override config at $overridePath
"
  source $overridePath
  echo "
Override config applied

"
fi

# Re-apply derivations that depend on project-overridable variables (see
# deriveDependentConfig in functions.inc.bash) so the override just sourced
# actually influences useInfection / phpUnitCoverage gating and MSI floors.
deriveDependentConfig

export pathsToCheck
export pathsToIgnore

cd "$projectRoot"

runTool prepareDirectories

# Install PHAR dependencies via PHIVE and isolated composer tools
$qaDir/../scripts/tool-install.bash

if [[ -f $projectConfigPath/hookPre.bash ]]; then
  echo "

Running Pre Hook $projectConfigPath/hookPre.bash
------------------------------------------------
"
  source $projectConfigPath/hookPre.bash
fi

#### LOCKING SYSTEM ##########################################

# Source lock and timing modules (use absolute paths based on qaDir)
source "$qaDir/../includes/generic/timing.inc.bash"
source "$qaDir/../includes/generic/lock.inc.bash"

# Initialize lock system and acquire lock
initLockSystem "$projectRoot"
acquireLock "$singleToolToRun" "$specifiedPath" || exit 1

# Set up cleanup trap
setupLockCleanup

#### PROCESS #################################################

if [[ "" != "$singleToolToRun" ]]; then
  echo "

Running Single Tool: $singleToolToRun
------------------------
"
  # Capture the tool's exit code via the if-condition so errexit is suspended:
  # a plain `runTool; exitCode=$?` under `set -e` aborts on failure before the
  # capture line, so exitCode could only ever be 0 (the historic bug).
  if runTool "$singleToolToRun"; then
    exitCode=0
  else
    exitCode=$?
  fi

  # A meta-target (allStatic/allLints/allTests/allCS) runs several leaf tools via
  # runToolGuarded, so in aggregate mode the authoritative result is the failure
  # tally, not the phase's own exit code.
  if [[ "true" == "$qaAggregate" ]]; then
    if qaReportAggregate; then
      exitCode=0
    else
      exitCode=1
    fi
  fi

  # Release lock with correct exit code before exiting
  trap - EXIT ERR INT TERM
  releaseLock $exitCode
  exit $exitCode
fi

echo "

Running All Coding Standards Tools (That Might Make Code Changes)
=================================

"
runTool allCodingStandardsTools

echo "

Running All Linting Tools
=========================

"

runTool allLintingTools

echo "

Running All Static Analysis Tools
=================================

"
runTool allStaticAnalysisTools

echo "

Running All Testing Tools
=========================

"
runTool allTestingTools

# In aggregate mode no leaf tool fails fast, so the run reaches here even when
# tools failed. Report the tally and stop before the success banner if any did.
if ! qaReportAggregate; then
  trap - EXIT ERR INT TERM
  releaseLock 1
  exit 1
fi

echo '


###############################
#                             #
#      ALL TESTS PASSING      #
#                             #
#            _                #
#           /(|               #
#          (  :               #
#         __\  \  _____       #
#       (____)  `|            #
#      (____)|   |            #
#       (____).__|            #
#        (___)__.|_____       #
#                             #
#                             #
###############################


'
echo "
Statistics:
"
runTool phploc
set +x

if [[ -f $projectConfigPath/hookPost.bash ]]; then
  echo "

Running Post Hook $projectConfigPath/hookPost.bash
------------------------------------------------
"
  source $projectConfigPath/hookPost.bash
fi

if [[ "false" != "$hasBeenRestarted" ]]; then
  echo "

####################################################################

WARNING - RAN WITH RETRIES

As you have restarted steps in this run,
you should run the whole process again to be sure everything is fine

####################################################################
"
fi

#### LOCKING SYSTEM - RELEASE ################################

# Clear the trap to prevent double-release, then explicitly release with success code
trap - EXIT ERR INT TERM
releaseLock 0

################################################################

echo "
===========================================
$(hostname) $0 $* COMPLETED
===========================================
"

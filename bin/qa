#!/usr/bin/env sh
# The php-qa-ci pipeline entrypoint.
#
# This is a shell shim rather than the PHP file itself so that every plausible
# way of reaching it works. A PHP file behind a `php` shebang runs correctly
# only when executed directly; hand it to a shell -- `bash bin/qa`, which is a
# habit no amount of documentation prevents -- and the shell reports a syntax
# error on the `<?php` line, naming neither PHP nor this file's real nature.
#
# The PHP lives in qa.php next to this file. PHP_QA_CI_PHP_EXECUTABLE selects
# the interpreter, the same variable the pipeline honours for every tool it
# spawns, so the entrypoint and the tools cannot disagree about which PHP is
# in use.

set -eu

phpQaCiBin="$(dirname "$0")"

exec "${PHP_QA_CI_PHP_EXECUTABLE:-php}" "${phpQaCiBin}/qa.php" "$@"

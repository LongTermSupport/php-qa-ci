#!/usr/bin/env php
<?php declare(strict_types=1);

require __DIR__.'/bootstrap.php';

if (!isset($argv[1]) || '' === $argv[1]) {
    fwrite(\STDERR, "Usage: infection-config-source-dirs-check <path-to-infection.json>\n");
    exit(1);
}

die(\LTS\PHPQA\InfectionConfig\InfectionConfigSourceDirectoriesCheck::main($argv[1]));

#!/usr/bin/env bash
# PHP-QA-CI-HOOK-SIGNATURE: pre-commit-check-vendor-uncommitted
# DO NOT EDIT: This hook is managed by php-qa-ci and will be automatically updated
#
# Git Pre-Commit Hook: Check Vendor Libraries for Uncommitted Changes
#
# PURPOSE:
# Prevents git commits when vendor libraries (first-party dependencies) have
# uncommitted changes. This prevents production failures where local changes
# work but production fails due to vendor/main synchronization issues.
#
# DEPLOYMENT:
# Copy to .git/hooks/pre-commit in your project:
#   cp vendor/lts/php-qa-ci/git-hooks/pre-commit-check-vendor-uncommitted .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use the deployment script (if implemented).
#
# INCIDENT THAT MOTIVATED THIS:
# - GREEN (dev) had uncommitted SupplierStockRowDto with 'duplicateSkus' parameter
# - Main project committed code using the new parameter
# - BLUE (production) ran composer update and pulled old DTO without parameter
# - Production failed: "Unknown named parameter $duplicateSkus"
#
# DETECTION:
# 1. Finds all vendor/*/* directories containing .git directories
# 2. Checks each for uncommitted changes (git status --porcelain)
# 3. Blocks commit if ANY vendor library has uncommitted changes
# 4. Provides clear instructions on proper workflow
#
# EXIT CODES:
# 0 - Allow commit (all vendor libraries clean)
# 1 - Block commit (uncommitted vendor changes detected)

set -euo pipefail

# Color output for better readability
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Get project root (where .git directory lives)
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
VENDOR_DIR="${PROJECT_ROOT}/vendor"

# Check if vendor directory exists
if [[ ! -d "$VENDOR_DIR" ]]; then
    # No vendor directory, nothing to check
    exit 0
fi

# Array to store vendor repos with uncommitted changes
DIRTY_REPOS=()
# Array to store vendor repos where composer.lock is out of sync
COMPOSER_OUT_OF_SYNC=()

# Parse composer.lock ONCE to build package -> commit map (fast!)
declare -A COMPOSER_COMMITS
if [[ -f "$PROJECT_ROOT/composer.lock" ]]; then
    while IFS='|' read -r package_name commit_ref; do
        COMPOSER_COMMITS["$package_name"]="$commit_ref"
    done < <(php -r '
        $json = json_decode(file_get_contents($argv[1]), true);
        foreach (["packages", "packages-dev"] as $section) {
            if (!isset($json[$section])) continue;
            foreach ($json[$section] as $pkg) {
                if (isset($pkg["source"]["reference"]) && $pkg["source"]["type"] === "git") {
                    echo $pkg["name"] . "|" . $pkg["source"]["reference"] . "\n";
                }
            }
        }
    ' "$PROJECT_ROOT/composer.lock" 2>/dev/null)
fi

# Unset git environment variables before scanning vendor sub-repos.
# When this hook runs from a git worktree, git exports GIT_DIR,
# GIT_WORK_TREE, and GIT_INDEX_FILE pointing to the worktree's metadata.
# If these leak into vendor sub-repo git commands, git ignores the vendor's
# own .git directory and reports thousands of spurious changes against the
# parent project's index. Unsetting them lets each vendor repo discover its
# own .git naturally.  PROJECT_ROOT and COMPOSER_COMMITS are already captured
# above, so this is safe.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Find all vendor/*/* directories that contain .git directories
while IFS= read -r -d '' git_dir; do
    # Get the repo directory (parent of .git)
    repo_dir="$(dirname "$git_dir")"

    # Get path relative to project root for display
    relative_path="${repo_dir#$PROJECT_ROOT/}"

    # Extract package name from path (vendor/org/package -> org/package)
    package_name="${relative_path#vendor/}"

    cd "$repo_dir"

    # Check 1: Uncommitted changes
    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
        # Get readable status for error message
        status_output="$(git status --short 2>/dev/null)"
        # Store repo path and status
        DIRTY_REPOS+=("${relative_path}|||${status_output}")
        # Skip composer.lock check - pointless if dirty
        continue
    fi

    # Check 2: composer.lock tracking current HEAD (only if repo is clean)
    current_commit="$(git rev-parse HEAD 2>/dev/null)"
    if [[ -n "$current_commit" ]]; then
        locked_commit="${COMPOSER_COMMITS[$package_name]}"

        # Check if composer.lock commit matches current HEAD
        if [[ -n "$locked_commit" ]] && [[ "$locked_commit" != "$current_commit" ]]; then
            COMPOSER_OUT_OF_SYNC+=("${relative_path}|||${locked_commit}|||${current_commit}")
        fi
    fi
done < <(find "$VENDOR_DIR" -mindepth 3 -maxdepth 3 -type d -name ".git" -print0 2>/dev/null)

# Return to project root
cd "$PROJECT_ROOT"

# If no issues found, allow commit
if [[ ${#DIRTY_REPOS[@]} -eq 0 ]] && [[ ${#COMPOSER_OUT_OF_SYNC[@]} -eq 0 ]]; then
    exit 0
fi

# Block commit - display error message
echo -e "${RED}┌─────────────────────────────────────────────────────────────────────────────┐${NC}"
echo -e "${RED}│                                                                             │${NC}"
echo -e "${RED}│  ⚠️  COMMIT BLOCKED: Vendor Library Issues Detected                         │${NC}"
echo -e "${RED}│                                                                             │${NC}"
echo -e "${RED}└─────────────────────────────────────────────────────────────────────────────┘${NC}"
echo ""

# Display uncommitted changes
if [[ ${#DIRTY_REPOS[@]} -gt 0 ]]; then
    echo -e "${YELLOW}ISSUE 1: Uncommitted changes in vendor libraries${NC}"
    echo ""
    for entry in "${DIRTY_REPOS[@]}"; do
        # Split on ||| delimiter
        repo_path="${entry%%|||*}"
        status="${entry#*|||}"

        echo -e "${YELLOW}  • ${repo_path}${NC}"
        # Indent status lines
        echo "$status" | sed 's/^/    /'
        echo ""
    done
fi

# Display composer.lock sync issues
if [[ ${#COMPOSER_OUT_OF_SYNC[@]} -gt 0 ]]; then
    echo -e "${YELLOW}ISSUE 2: composer.lock not tracking current vendor commits${NC}"
    echo ""
    for entry in "${COMPOSER_OUT_OF_SYNC[@]}"; do
        # Split on ||| delimiter - save IFS first
        OLD_IFS="$IFS"
        IFS='|||'
        read -r repo_path locked_commit current_commit <<< "$entry"
        IFS="$OLD_IFS"

        echo -e "${YELLOW}  • ${repo_path}${NC}"
        if [[ -z "$locked_commit" ]]; then
            echo "    composer.lock: (not found - package may not be installed via source)"
        else
            echo "    composer.lock: ${locked_commit:0:8}"
        fi
        echo "    current HEAD:  ${current_commit:0:8}"
        echo ""
    done
fi

echo -e "${RED}═══════════════════════════════════════════════════════════════════════════════${NC}"
echo -e "${RED}WHY THIS IS BLOCKED:${NC}"
echo ""
echo "  • Vendor libraries are git-tracked first-party dependencies"
echo "  • Committing main project with uncommitted vendor changes causes production failures"
echo "  • Your code may use features not yet committed to vendor repos"
echo "  • Composer in production won't have these changes, causing runtime errors"
echo ""
echo -e "${RED}PRODUCTION INCIDENT EXAMPLE:${NC}"
echo "  • GREEN (dev) had uncommitted SupplierStockRowDto with 'duplicateSkus' parameter"
echo "  • Main project committed code using 'duplicateSkus: \$row[...]'"
echo "  • BLUE (production) composer update pulled old DTO without the parameter"
echo "  • Production failed: 'Unknown named parameter \$duplicateSkus'"
echo ""
echo -e "${GREEN}HOW TO FIX:${NC}"
echo ""

if [[ ${#DIRTY_REPOS[@]} -gt 0 ]]; then
    echo -e "${GREEN}For uncommitted changes:${NC}"
    echo "   1. cd vendor/org/package"
    echo "   2. git add ."
    echo "   3. git commit -m \"feat: Add feature\""
    echo "   4. git push"
    echo "   5. cd ${PROJECT_ROOT}"
    echo "   6. composer update vendor/org/package"
    echo ""
fi

if [[ ${#COMPOSER_OUT_OF_SYNC[@]} -gt 0 ]]; then
    echo -e "${GREEN}For composer.lock out of sync:${NC}"
    echo "   composer update vendor/org/package"
    echo ""
fi

echo -e "${GREEN}After fixing vendor issues, retry your commit:${NC}"
echo "   git commit"
echo ""
echo -e "${YELLOW}WORKFLOW:${NC}"
echo "  Vendor changes → Vendor commit → Composer update → Main commit"
echo ""
echo -e "${RED}═══════════════════════════════════════════════════════════════════════════════${NC}"
echo ""
echo "This ensures production can access all vendor features your code depends on."
echo ""

# Exit with error to block commit
exit 1
